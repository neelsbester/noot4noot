{
  "name": "@noot4noot/multiplayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "check": "npm run types && npm run typecheck && npm run lint && npm test",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "dev": "wrangler dev --env local --port 5173",
    "lint": "eslint src test web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "@eslint/js": "latest",
    "@types/node": "^26.1.1",
    "eslint": "latest",
    "globals": "^16.5.0",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "jose": "^6.2.3"
  }
}
