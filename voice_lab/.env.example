# Create voice_lab/.env and add a server-side OpenAI API key.
# Never expose this value through browser JavaScript.
OPENAI_API_KEY=sk-your-project-key-here

# Optional overrides
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# `off` is the measured low-latency default; near_field and far_field are supported.
OPENAI_INPUT_NOISE_REDUCTION=off
VOICE_LAB_HOST=127.0.0.1
VOICE_LAB_PORT=8787
